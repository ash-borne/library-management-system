# Copy this file to .env and replace the placeholders with your own values.
# Never commit the real .env file.

# PostgreSQL connection string (for example from Prisma Postgres, Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign and verify JWTs. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Password given to the two sample accounts created by "npx prisma db seed"
# (librarian@example.com and patron@example.com). Development only.
SEED_USER_PASSWORD="ChangeMe123!"
